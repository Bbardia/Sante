{
  "name": "sante-desktop",
  "version": "0.0.1",
  "description": "Santé POS desktop shell",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "engines": {
    "node": ">=18",
    "electron": ">=22"
  },
  "devDependencies": {
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "swiss.sensopro.sante",
    "productName": "Santé",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/sante-backend.exe",
        "to": "backend/"
      },
      {
        "from": "../frontend/dist/",
        "to": "frontend/"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
